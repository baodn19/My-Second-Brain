filters:
  and:
    - categories.contains("Ideas")
    - '!file.name.contains("Template")'
views:
  - type: table
    name: Table
    order:
      - file.name
      - domain
      - maturity
    sort:
      - property: domain
        direction: ASC
    columnSize:
      file.name: 381
      note.domain: 271
