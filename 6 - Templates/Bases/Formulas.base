filters:
  and:
    - categories.contains("Formulas")
    - '!file.name.contains("Template")'
formulas:
  Formula: html(note.formula)
views:
  - type: table
    name: Table
    order:
      - file.name
      - tags
      - formula.Formula
    sort:
      - property: formula.Formula
        direction: ASC
    columnSize:
      file.name: 217
  - type: table
    name: Electrical
    filters:
      and:
        - file.tags.contains("Electrical")
    order:
      - file.name
      - formula.Formula
    columnSize:
      file.name: 294
  - type: table
    name: Robot Kinematics
    filters:
      and:
        - file.tags.contains("robot-kinematics")
    order:
      - file.name
      - formula.Formula
