filters:
  and:
    - categories.contains(link("Strawberry detection on edge device"))
    - '!file.name.contains("Template")'
views:
  - type: table
    name: First Pass
    filters:
      and:
        - pass == ["first"]
    order:
      - file.name
      - tags
      - year
  - type: table
    name: Second Pass
    filters:
      and:
        - pass == ["second"]
  - type: table
    name: Thrid Pass
    filters:
      and:
        - pass == ["third"]
