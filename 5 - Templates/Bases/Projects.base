filters:
  and:
    - '!file.name.contains("Template")'
    - note.categories.contains(link("Projects"))
properties:
  note.status:
    displayName: Status
  note.url:
    displayName: URL
  file.name:
    displayName: Name
  note.type:
    displayName: Type
  note.year:
    displayName: Year
views:
  - type: table
    name: Table
    order:
      - file.basename
      - year
      - status
    sort:
      - property: year
        direction: DESC
      - property: status
        direction: ASC
    columnSize:
      file.basename: 150
      note.year: 87
