filters:
  and:
    - '!file.name.contains("Template")'
    - note.categories.contains(link("Projects"))
properties:
  note.status:
    displayName: Status
  note.url:
    displayName: URL
  file.name:
    displayName: Name
  note.type:
    displayName: Type
  note.year:
    displayName: Year
views:
  - type: table
    name: All
    order:
      - file.name
      - year
      - status
  - type: table
    name: Ongoing
    filters:
      and:
        - status == ["ongoing"]
    order:
      - file.name
      - year
    sort:
      - property: year
        direction: DESC
      - property: status
        direction: ASC
    columnSize:
      file.basename: 150
      note.year: 87
    markers: none
    indentProperties: false
  - type: table
    name: Completed
    filters:
      and:
        - status.contains("completed")
    order:
      - file.name
      - year
  - type: table
    name: Resumed
    filters:
      and:
        - status == ["resumed"]
    order:
      - file.name
      - year
