filters:
  and:
    - categories.contains(link("Interview Questions"))
    - '!file.name.contains("Template")'
views:
  - type: table
    name: Experiential
    filters:
      and:
        - file.tags.contains("experiential")
    order:
      - file.name
    columnSize:
      file.name: 484
  - type: table
    name: Uncategorized
    filters:
      and:
        - file.tags == []
    order:
      - file.name
      - tags
  - type: table
    name: Definitional
    filters:
      and:
        - file.tags.contains("definitional")
  - type: table
    name: In Progress
    filters:
      and:
        - file.tags.contains("in-progress")
